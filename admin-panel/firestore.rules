rules_version = '2';
// DT Solar Pro — Super Admin portal + desktop licensing on the Firebase Spark plan (Firestore + Auth only).
// The data model is documented in DATA_MODEL.md. Every "server side" check lives here.
service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------ helpers ------------------------------------------------ */

    function signedIn() { return request.auth != null; }
    function adminPath() { return /databases/$(database)/documents/admins/$(request.auth.uid); }
    function adminData() { return get(adminPath()).data; }
    function isAdmin() {
      return signedIn() && exists(adminPath()) && adminData().get('active', true) == true;
    }
    function isOwnerRole(role) { return role in ['owner', 'superadmin']; }
    function isOwner() { return isAdmin() && isOwnerRole(adminData().get('role', '')); }
    function can(p) {
      return isAdmin() && (isOwnerRole(adminData().get('role', '')) || p in adminData().get('permissions', []));
    }
    function canAny(ps) {
      return isAdmin() && (isOwnerRole(adminData().get('role', '')) || adminData().get('permissions', []).hasAny(ps));
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || str(d[k], max); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Secret ids: long random strings (never listed).
    function secretId(id, min) { return id.size() >= min && id.size() <= 64 && id.matches('^[A-Za-z0-9_-]+$'); }

    /* ------------------------------------------------ admins ------------------------------------------------ */

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if can('admins.manage');
      // Bootstrap: the owner e-mail creates its own owner record once. Otherwise owners create anyone, and admins
      // holding admins.manage create non-owner admins that cannot manage admins themselves.
      allow create: if
        (signedIn() && request.auth.uid == uid && request.auth.token.email == 'digitaltarget.digital@gmail.com'
          && isOwnerRole(request.resource.data.role))
        || isOwner()
        || (can('admins.manage') && !isOwnerRole(request.resource.data.get('role', ''))
            && !('admins.manage' in request.resource.data.get('permissions', [])));
      // Nobody changes their own role / permissions / active flag. Only owners touch owner records or grant admins.manage.
      allow update: if isAdmin() && (
        (request.auth.uid == uid && changed().hasOnly(['name', 'updatedAt']))
        || (request.auth.uid != uid && isOwner())
        || (request.auth.uid != uid && can('admins.manage')
            && !isOwnerRole(resource.data.get('role', '')) && !isOwnerRole(request.resource.data.get('role', ''))
            && !('admins.manage' in request.resource.data.get('permissions', []))
            && !('admins.manage' in resource.data.get('permissions', [])))
      );
      allow delete: if isOwner() && request.auth.uid != uid;
    }

    /* ----------------------------------------------- clients ----------------------------------------------- */

    match /clients/{clientId} {
      allow read: if can('clients.view');
      allow create, update: if can('clients.manage')
        && str(request.resource.data.get('company', ''), 200)
        && request.resource.data.get('status', 'active') in ['active', 'suspended', 'archived']
        && (!('logo' in request.resource.data) || request.resource.data.logo == null || str(request.resource.data.logo, 300000));
      // Hard delete (the portal first unlinks the client's non-active licenses and refuses while an active one is linked).
      allow delete: if can('clients.manage');
    }

    /* ----------------------------------------------- licenses ----------------------------------------------- */

    // Instant activation (no server on Spark): the desktop, holding the activation pass fetched with the license key,
    // registers ONE brand-new computer in a single commit — license counter + summary entry + device record.
    // Accepted only while the license is active and not expired, a slot is free and the computer was never registered
    // on this license (released / deactivated computers and full licenses still need an admin approval).
    function licPath(lid) { return /databases/$(database)/documents/licenses/$(lid); }
    function devPath(lid, did) { return /databases/$(database)/documents/licenses/$(lid)/devices/$(did); }
    function validDeviceId(did) { return did is string && did.size() >= 10 && did.size() <= 64 && did.matches('^[A-Za-z0-9_-]+$'); }
    function selfActivation(lid) {
      let d = request.resource.data;
      let did = d.get('selfActivatedDevice', '');
      let before = resource.data.get('devicesSummary', null);
      return resource.data.status == 'active'
        && (resource.data.get('expiresAt', null) == null || resource.data.expiresAt > request.time)
        && changed().hasOnly(['activeDevices', 'devicesSummary', 'updatedAt', 'selfActivatedDevice'])
        && validDeviceId(did)
        && before is map
        && !(did in before)
        && d.activeDevices == resource.data.get('activeDevices', 0) + 1
        && d.activeDevices <= resource.data.get('maxDevices', 1)
        && d.devicesSummary.diff(before).affectedKeys().hasOnly([did])
        && d.devicesSummary[did].keys().hasOnly(['deviceName', 'os', 'appVersion', 'status', 'activatedAt', 'activationType', 'statusNote'])
        && d.devicesSummary[did].status == 'active'
        && d.devicesSummary[did].activationType == 'instant'
        && d.devicesSummary[did].activatedAt == request.time
        && d.updatedAt == request.time
        && !exists(devPath(lid, did))
        && existsAfter(devPath(lid, did))
        && !(did in get(/databases/$(database)/documents/licenseStatus/$(lid)).data.get('deactivatedDevices', []));
    }
    function selfDevice(lid, did) {
      let d = request.resource.data;
      let after = getAfter(licPath(lid)).data;
      return validDeviceId(did)
        && after.get('selfActivatedDevice', '') == did
        && after.activeDevices == get(licPath(lid)).data.get('activeDevices', 0) + 1
        && d.keys().hasOnly(['deviceId', 'deviceName', 'os', 'appVersion', 'status', 'activatedAt', 'activationType',
             'statusNote', 'installToken'])
        && d.deviceId == did && d.status == 'active' && d.activationType == 'instant'
        && d.activatedAt == request.time
        && optStr(d, 'deviceName', 200) && optStr(d, 'os', 200) && optStr(d, 'appVersion', 40)
        && optStr(d, 'statusNote', 300) && optStr(d, 'installToken', 64);
    }

    match /licenses/{licenseId} {
      allow read: if canAny(['licenses.view', 'licenses.manage', 'licenses.generate', 'devices.view', 'devices.manage', 'verify.use', 'billing.create', 'clients.view']);
      allow create: if canAny(['licenses.generate', 'licenses.manage'])
        && request.resource.data.licenseKey is string
        && request.resource.data.licenseKey.matches('^DTSP(-[A-Z0-9]{4}){4}$')
        && request.resource.data.status in ['active', 'suspended', 'revoked'];
      // Status / terms changes need licenses.manage; device approvals only touch the device counter + devicesSummary.
      allow update: if (can('licenses.manage') && request.resource.data.status in ['active', 'suspended', 'revoked']
                        && request.resource.data.licenseKey == resource.data.licenseKey)
        || (canAny(['devices.manage', 'licenses.generate'])
            && changed().hasOnly(['activeDevices', 'devicesSummary', 'updatedAt', 'lastVerifiedAt', 'activatedAt', 'clientId', 'passHash']))
        || selfActivation(licenseId);
      allow delete: if isOwner();

      match /devices/{deviceId} {
        allow read: if canAny(['licenses.view', 'licenses.manage', 'devices.view', 'devices.manage']);
        // The desktop reads its own record by id (licenseId is only known to certificate / pass holders).
        allow get: if true;
        // Registered by an admin approval (devices.manage) or by instant activation (see selfActivation).
        allow create: if can('devices.manage') || selfDevice(licenseId, deviceId);
        allow update: if canAny(['licenses.manage', 'devices.manage']);
        // Only released / deactivated device records can be removed (clearing device history); active ones only when
        // the owner deletes the whole license (the license is gone after this write / batch).
        allow delete: if (canAny(['licenses.manage', 'devices.manage']) && resource.data.get('status', 'active') != 'active')
          || (isOwner() && !existsAfter(/databases/$(database)/documents/licenses/$(licenseId)));
      }
      match /history/{entryId} {
        allow read: if canAny(['licenses.view', 'licenses.manage', 'devices.view', 'devices.manage']);
        allow create: if canAny(['licenses.manage', 'licenses.generate', 'devices.manage']);
        allow update: if false;
        // Clearing license history is an owner / audit.manage action; the clearing itself is logged as a 'security' entry.
        // Deleting a whole license (owner) removes its history too.
        allow delete: if can('audit.manage') || (isOwner() && !existsAfter(/databases/$(database)/documents/licenses/$(licenseId)));
      }
    }

    // Activation pass (see selfActivation), fetched by the SHA-256 of the license key; never listable.
    match /activationPasses/{hash} {
      allow get: if true;
      allow list: if false;
      allow write: if canAny(['licenses.manage', 'licenses.generate']) && hash.matches('^[0-9a-f]{64}$');
    }

    // Public status of one license, read by the desktop app by id (cannot be listed).
    match /licenseStatus/{licenseId} {
      allow get: if true;
      allow list: if canAny(['licenses.view', 'licenses.manage', 'devices.view']);
      allow write: if canAny(['licenses.manage', 'licenses.generate', 'devices.manage']);
    }

    /* ------------------------------------------ desktop → cloud ------------------------------------------ */

    // Activation / deactivation requests created by the desktop app; read back by their random id.
    match /activationRequests/{requestId} {
      allow get: if true;
      allow list, update, delete: if canAny(['devices.manage', 'licenses.manage']);
      allow create: if secretId(requestId, 20)
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['type', 'licenseKey', 'licenseId', 'deviceId', 'deviceName', 'appVersion',
             'os', 'status', 'createdAt', 'companyName', 'ownerName', 'phone', 'address', 'installToken'])
        && request.resource.data.type in ['activate', 'deactivate']
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() >= 10
        && request.resource.data.deviceId.size() <= 64
        && (request.resource.data.type != 'activate' ||
            (request.resource.data.licenseKey is string &&
             request.resource.data.licenseKey.matches('^DTSP(-[A-Z0-9]{4}){4}$')))
        && optStr(request.resource.data, 'licenseId', 64)
        && optStr(request.resource.data, 'deviceName', 200)
        && optStr(request.resource.data, 'appVersion', 40)
        && optStr(request.resource.data, 'os', 200)
        && optStr(request.resource.data, 'companyName', 200)
        && optStr(request.resource.data, 'ownerName', 200)
        && optStr(request.resource.data, 'phone', 60)
        && optStr(request.resource.data, 'address', 300)
        && optStr(request.resource.data, 'installToken', 64);
    }

    // Device heartbeat (online status, version, optional consented location). Id = the installation's secret token.
    function validLocation(l) {
      return l is map
        && l.keys().hasOnly(['lat', 'lng', 'accuracyKm', 'source', 'label', 'consent', 'updatedAt'])
        && l.lat is number && l.lat >= -90 && l.lat <= 90
        && l.lng is number && l.lng >= -180 && l.lng <= 180
        && l.source in ['device', 'approximate', 'manual']
        && l.consent == true
        && (!('accuracyKm' in l) || l.accuracyKm is number)
        && (!('label' in l) || str(l.label, 200))
        && (!('updatedAt' in l) || str(l.updatedAt, 40));
    }
    function validHeartbeat(d) {
      return d.keys().hasOnly(['deviceId', 'licenseId', 'deviceName', 'os', 'appVersion', 'companyName', 'mode',
             'lastCheckAt', 'firms', 'users', 'lastSeen', 'location'])
        && d.deviceId is string && d.deviceId.size() >= 10 && d.deviceId.size() <= 64
        && d.lastSeen == request.time
        && optStr(d, 'licenseId', 64) && optStr(d, 'deviceName', 200) && optStr(d, 'os', 200)
        && optStr(d, 'appVersion', 40) && optStr(d, 'companyName', 200) && optStr(d, 'mode', 30)
        && optStr(d, 'lastCheckAt', 40)
        && (!('firms' in d) || d.firms is int) && (!('users' in d) || d.users is int)
        && (!('location' in d) || d.location == null || validLocation(d.location));
    }
    match /heartbeats/{token} {
      allow get, list: if canAny(['devices.view', 'devices.manage', 'licenses.view']);
      allow create, update: if secretId(token, 32) && validHeartbeat(request.resource.data);
      allow delete: if can('devices.manage');
    }

    // Support conversation of one installation. Id = the installation's secret token.
    function customerThreadFields() {
      return ['deviceId', 'licenseId', 'companyName', 'contactName', 'phone', 'status', 'lastMessageAt',
              'lastMessageFrom', 'lastMessagePreview', 'unreadByAdmin', 'unreadByCustomer', 'createdAt'];
    }
    function validCustomerThread(d) {
      return d.keys().hasOnly(customerThreadFields())
        && d.deviceId is string && d.deviceId.size() >= 10 && d.deviceId.size() <= 64
        && optStr(d, 'licenseId', 64) && optStr(d, 'companyName', 200) && optStr(d, 'contactName', 200)
        && optStr(d, 'phone', 60) && optStr(d, 'lastMessagePreview', 200)
        && d.get('status', 'open') in ['open', 'pending', 'resolved']
        && d.get('lastMessageFrom', 'customer') in ['customer', 'admin'];
    }
    match /supportThreads/{token} {
      allow get: if secretId(token, 32) || can('support.manage');
      allow list: if can('support.manage');
      allow create: if secretId(token, 32) && validCustomerThread(request.resource.data)
        && request.resource.data.get('status', 'open') == 'open'
        && request.resource.data.get('lastMessageFrom', 'customer') == 'customer';
      // The customer may post (re-opens the thread) or mark replies read; admins manage status and replies.
      allow update: if can('support.manage')
        || (secretId(token, 32) && validCustomerThread(request.resource.data)
            && changed().hasOnly(['companyName', 'contactName', 'phone', 'licenseId', 'status', 'lastMessageAt',
                                  'lastMessageFrom', 'lastMessagePreview', 'unreadByAdmin', 'unreadByCustomer'])
            && (!('status' in changed()) || request.resource.data.status == 'open')
            && (!('lastMessageFrom' in changed()) || request.resource.data.lastMessageFrom == 'customer')
            && (!('lastMessageAt' in changed()) || request.resource.data.lastMessageAt == request.time)
            && (!('unreadByAdmin' in changed()) || request.resource.data.unreadByAdmin == true)
            && (!('unreadByCustomer' in changed()) || request.resource.data.unreadByCustomer == false));
      allow delete: if isOwner();

      match /messages/{messageId} {
        allow get, list: if secretId(token, 32) || can('support.manage');
        allow create: if secretId(messageId, 8)
          && request.resource.data.keys().hasOnly(['from', 'body', 'authorName', 'at'])
          && str(request.resource.data.body, 4000) && request.resource.data.body.size() > 0
          && optStr(request.resource.data, 'authorName', 120)
          && request.resource.data.at == request.time
          && ((secretId(token, 32) && request.resource.data.from == 'customer')
              || (can('support.manage') && request.resource.data.from == 'admin'));
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    /* ----------------------------------------------- billing ----------------------------------------------- */

    function validInvoice(d) {
      return d.number is string && d.number.size() <= 40
        && d.total is number && d.total >= 0
        && d.paid is number && d.paid >= 0 && d.paid <= d.total + 0.01
        && d.balance is number
        && d.status in ['unpaid', 'partial', 'paid', 'cancelled']
        && d.lines is list && d.lines.size() <= 100
        && d.verifyToken is string && d.verifyToken.size() >= 24;
    }
    match /invoices/{invoiceId} {
      allow read: if canAny(['billing.view', 'billing.create', 'billing.payments']);
      allow create: if can('billing.create') && validInvoice(request.resource.data)
        && request.resource.data.paid == 0 && request.resource.data.status == 'unpaid';
      // Editing terms needs billing.create; recording payments only moves the paid/balance/status fields.
      allow update: if validInvoice(request.resource.data)
        && request.resource.data.verifyToken == resource.data.verifyToken
        && request.resource.data.number == resource.data.number
        && resource.data.status != 'cancelled'
        && (can('billing.create')
            || (can('billing.payments') && changed().hasOnly(['paid', 'balance', 'status', 'updatedAt', 'lastPaymentAt'])));
      // Deletion (billing.create / owner): only a cancelled invoice or one without money recorded (paid == 0).
      allow delete: if can('billing.create') && (resource.data.status == 'cancelled' || resource.data.get('paid', 0) == 0);

      match /payments/{paymentId} {
        allow read: if canAny(['billing.view', 'billing.create', 'billing.payments']);
        allow create: if can('billing.payments') && request.resource.data.amount is number && request.resource.data.amount > 0;
        allow update: if can('billing.payments')
          && changed().hasOnly(['cancelled', 'cancelledAt', 'cancelledBy', 'cancelReason'])
          && request.resource.data.cancelled == true;
        // Only together with the invoice itself, in the same batch.
        allow delete: if can('billing.create')
          && !existsAfter(/databases/$(database)/documents/invoices/$(invoiceId));
      }
    }

    // Public verification copy of an invoice, fetched by its unguessable token (QR code). Never listable.
    match /publicInvoices/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if canAny(['billing.create', 'billing.payments']) && secretId(token, 24)
        && request.resource.data.status in ['valid', 'cancelled'];
      allow delete: if can('billing.create');
    }

    match /counters/{name} {
      allow read, write: if canAny(['billing.create', 'billing.payments', 'clients.manage', 'licenses.generate']);
    }

    /* ---------------------------------------------- settings ---------------------------------------------- */

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if can('branding.manage');
    }
    match /publicSettings/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if can('branding.manage');
    }

    /* --------------------------------------------- audit log --------------------------------------------- */

    match /auditLogs/{id} {
      allow read: if can('audit.view');
      allow create: if isAdmin() && request.resource.data.byUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.get('archived', false) == false;
      allow update: if can('audit.manage') && changed().hasOnly(['archived', 'archivedAt', 'archivedBy'])
        && request.resource.data.archived == true;
      // Retention policy: ordinary activity (any category except 'security') may be cleared by an owner or an admin
      // holding audit.manage, at any age. 'security' records (sign-ins, permission changes, log clearing itself) are a
      // protected audit trail and can never be deleted from the portal.
      allow delete: if can('audit.manage') && resource.data.get('category', 'license') != 'security';
    }
  }
}
